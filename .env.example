# Copy to .env (or export these in your shell) and fill in.

# Required for anything beyond local testing — signs login tokens.
SECRET_KEY=change-this-to-a-long-random-string

# Stripe. Leave blank for TEST MODE (simulated payments, no real charges).
# To go live: paste your keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public URL of the deployed app (used for referral links + Stripe redirects).
BASE_URL=http://localhost:5050

# Seed an admin account on first run (can log in at #/login, then open Admin).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: custom port / database path
PORT=5050
# DATABASE=./data/whalepool.db
